export class BookingPage{
    constructor(page){
        this.page=page
        this.location= page.locator('//select[@id="location"]')
        this.hotel = page.locator('//select[@id="hotels"]')
        this.roomType = page.locator('//select[@id="room_type"]')
        this.noOfRooms = page.locator('//select[@id="room_nos"]')
        this.checkinDate= page.locator('//input[@id="datepick_in"]')
        this.checkoutDate = page.locator('//input[@id="datepick_out"]')
        this.noOfAdults = page.locator('//select[@id="adult_room"]')
        this.noOfChildren = page.locator('//select[@id="child_room"]')
        this.clickButton = page.locator('//input[@id="Submit"]')
    }

    async selectLocation() {
        await this.location.selectoption({label:'Adelaide'})
    }
    
    async selectHotel() {
        await this.hotel.selectoption({label:'Hotel Sunshine'})
    }

    async selectRoomType() {
        await this.roomType.selectoption({label:'Super Deluxe'})
    }

    async selectRooms() {
        await this.noOfRooms.selectoption({label:'1 - One'})
    }

    async checkin() {
        await this.checkinDate.fill('10/08/2026')
    }

    async checkOut() {
        await this.checkOut.fill('10/09/2026')
    }

    async selectAdults() {
        await this.noOfAdults.selectoption({label:'2 - Two'})
    }

    async selectChildren() {
        await this.noOfChildren.selectoption({label:'1 - One'})
    }

    async clickButton() {
        await this.clickButton.click()
    }
}